{% extends "/shared/no-nav.jinja" %}
{% block nav %}
<a class="icon-bnt" href="{{ url_for('portal.portal') }}" title="Home" data-testid="home_irwh">{{ macros.feather_img('home') }}</a>
{% if current_user.is_authenticated %}
<a class="icon-bnt" href="{{ url_for('settings.get_index') }}" title="Settings" data-testid="settings_drjr">{{ macros.feather_img('settings') }}</a>
<a class="icon-bnt" href="{{ url_for('login.get_logout') }}" data-testid="logout_aelc">{{ macros.feather_img('log-out') }}Log Out</a>
{% else %}
<a class="icon-bnt" href="{{ url_for('login.get_login') }}" data-testid="login_fwps">{{ macros.feather_img('log-in') }}Log In</a>
{% endif %}
{% endblock %}
